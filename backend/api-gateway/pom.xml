<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- =========================================================
         SPRING BOOT
         ========================================================= -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.office_management</groupId>
	<artifactId>api-gateway</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>api-gateway</name>
	<description>API Gateway for Office Management System</description>

	<!-- =========================================================
         JAVA
         ========================================================= -->
	<properties>
		<java.version>21</java.version>

		<!-- Spring Cloud compatible with Spring Boot 4.1.x -->
		<spring-cloud.version>2025.1.3</spring-cloud.version>
	</properties>

	<!-- =========================================================
         SPRING CLOUD BOM
         ========================================================= -->
	<dependencyManagement>
		<dependencies>

			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<dependencies>

		<!-- =====================================================
             SPRING CLOUD GATEWAY - WEBFLUX

             IMPORTANT:
             This is a reactive gateway.
             Do NOT add spring-boot-starter-web.
             ===================================================== -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>

		<!-- =====================================================
             EUREKA CLIENT
             ===================================================== -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!-- =====================================================
             REACTIVE WEB

             Gateway already uses WebFlux, but explicitly having
             the starter is useful if your project contains
             reactive security/configuration classes.
             ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

		<!-- =====================================================
             ACTUATOR
             ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- =====================================================
             SECURITY
             Only keep this if your gateway has SecurityConfig,
             JWT authentication, OAuth2, etc.
             ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- =====================================================
             TESTING
             ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- =========================================================
         BUILD
         ========================================================= -->
	<build>

		<finalName>office-api-gateway</finalName>

		<plugins>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>

	</build>

</project>